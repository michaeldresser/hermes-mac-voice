+  // repeats the last word (or few) of the previous segment. Short words like
+  // "is" matter here, which a character-length threshold would miss.
+  const headWords = head.split(/\s+/)
+  const nextWords = next.split(/\s+/)
+  const maxWords = Math.min(4, headWords.length, nextWords.length)
